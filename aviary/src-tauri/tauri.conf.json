{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aviary",
  "version": "0.1.1",
  "identifier": "app.aviary.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aviary",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.aviary/media/**",
          "$HOME/.aviary/cache/thumbs/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.icns"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "dmg": {
        "windowPosition": {
          "x": 200,
          "y": 120
        },
        "windowSize": {
          "width": 660,
          "height": 420
        },
        "appPosition": {
          "x": 165,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 495,
          "y": 190
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGMjE1N0U4OEUyMzBFMjEKUldRaERpT082RmNocitKNW1JMHREU1c2Ym01dkFYWm1MY3phNWNVbDlDeFUrbEdweE85NHZ2Y20K",
      "endpoints": [
        "https://github.com/MedSlimane/Aviary/releases/download/updater-alpha/latest.json"
      ]
    }
  }
}
