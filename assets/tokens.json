{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Aviary Visual Foundation",
  "version": "1.0.0",
  "gradients": {
    "aurora": {
      "stops": [
        "#4E38A7",
        "#8D7AE8",
        "#75B9F0",
        "#E5ECFF",
        "#FFF8F0"
      ]
    },
    "ember": {
      "stops": [
        "#9E3857",
        "#E66B66",
        "#F6A75D",
        "#FFD68F",
        "#F3A0B7"
      ]
    },
    "tidal": {
      "stops": [
        "#195E6B",
        "#3C9B9A",
        "#8BCFC3",
        "#DCE7BD",
        "#F3DBA5"
      ]
    },
    "dusk": {
      "stops": [
        "#14152F",
        "#272251",
        "#673369",
        "#B34E78",
        "#E69098"
      ]
    }
  },
  "neutral": {
    "dark": {
      "bg-canvas": "#090A0D",
      "bg-surface": "#101116",
      "bg-elevated": "#181A21",
      "border-subtle": "#242630",
      "border-strong": "#383B48",
      "text-primary": "#F4F4F6",
      "text-secondary": "#B5B7C0",
      "text-tertiary": "#7B7E8A"
    },
    "light": {
      "bg-canvas": "#F6F6F8",
      "bg-surface": "#FFFFFF",
      "bg-elevated": "#FFFFFF",
      "border-subtle": "#E4E5E9",
      "border-strong": "#CACCD3",
      "text-primary": "#17181C",
      "text-secondary": "#555862",
      "text-tertiary": "#858893"
    }
  },
  "radius": {
    "none": "0px",
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "2xl": "32px",
    "pill": "999px"
  },
  "blur": {
    "none": "0px",
    "subtle": "8px",
    "soft": "16px",
    "material": "28px",
    "atmospheric": "48px",
    "bloom": "80px",
    "macro": "120px"
  },
  "shadow": {
    "card": {
      "css": "0 1px 0 rgba(255,255,255,0.04) inset, 0 10px 30px rgba(0,0,0,0.24)",
      "color": "#0000003D",
      "x": "0px",
      "y": "10px",
      "blur": "30px",
      "spread": "0px"
    },
    "popover": {
      "css": "0 1px 0 rgba(255,255,255,0.05) inset, 0 18px 50px rgba(0,0,0,0.38)",
      "color": "#00000061",
      "x": "0px",
      "y": "18px",
      "blur": "50px",
      "spread": "-4px"
    },
    "modal": {
      "css": "0 1px 0 rgba(255,255,255,0.06) inset, 0 28px 90px rgba(0,0,0,0.52)",
      "color": "#00000085",
      "x": "0px",
      "y": "28px",
      "blur": "90px",
      "spread": "-8px"
    },
    "focus": {
      "css": "0 0 0 3px rgba(141,122,232,0.34), 0 0 24px rgba(117,185,240,0.18)",
      "color": "#8D7AE857",
      "x": "0px",
      "y": "0px",
      "blur": "0px",
      "spread": "3px"
    }
  }
}
